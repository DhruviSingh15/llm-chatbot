# ==========================================
# ContextAI Environment Configuration (Template)
# ==========================================

# Choose your provider: "gemini" or "openai" (or leave blank to auto-detect based on provided key)
LLM_PROVIDER=gemini

# --- Google Gemini Configuration ---
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- OpenAI Configuration ---
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Context Window Management Settings ---
# Maximum messages retained in sliding window context (e.g. 10 messages = 5 user + 5 assistant turns)
MAX_CONTEXT_MESSAGES=10

# Context strategy: "sliding_window" or "summarization"
CONTEXT_STRATEGY=sliding_window

# Flask Server Port
PORT=5000
